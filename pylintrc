[MASTER]
# This is a teaching library; the refactor warnings below are silenced because
# the code is deliberately written step by step for legibility:
#  - too-many-lines:       DES.py and Blowfish.py are over 1000 lines because
#                          they hold the spec's constant tables (S-boxes,
#                          P-array, permutations).
#  - too-many-statements, too-many-branches, too-many-return-statements:
#                          Serpent's sixteen hard-coded S-box gate networks
#                          (one long function) and the match/case dispatch in
#                          EncryptionBase.pad_for_mode.
#  - too-many-locals:      Twofish's verbose key schedule and the oracle
#                          harness in examples/verify_vectors.py.
#  - too-many-arguments, too-many-positional-arguments:
#                          one helper in examples/benchmark.py takes six
#                          arguments.
#  - duplicate-code:       the test modules all end with the same short
#                          ``unittest.main()`` boilerplate and near-identical
#                          one-line assertions, which pylint reports as
#                          duplicates.

# The scripts under examples/ import the ``refciphers`` package (under src/)
# and the repo-root tests/ package. pylint puts each file's own directory on
# sys.path rather than the current working directory, so without this neither
# import would resolve and every one would be reported as an import-error.
init-hook='import sys; sys.path.insert(0, "src"); sys.path.insert(0, ".")'

[BASIC]
# Module files carry proper-cased cipher names (AES.py, Twofish.py, ...).
module-rgx=^([a-z_][a-z0-9_]*|[A-Z][a-zA-Z0-9]*)$

[MESSAGES CONTROL]
disable=too-many-lines,
    too-many-return-statements,
    too-many-branches,
    too-many-locals,
    too-many-statements,
    too-many-arguments,
    too-many-positional-arguments,
    duplicate-code